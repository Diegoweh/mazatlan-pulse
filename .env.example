# ---- Site -------------------------------------------------------------------
# Canonical origin. Used by metadataBase, sitemap.ts, robots.ts and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never import into a
# Client Component. Used by /scripts, the cron route and admin server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI ingest pipeline (phase 2) -------------------------------------------
ANTHROPIC_API_KEY=

# Shared secret for the Vercel Cron route. Vercel Cron sends this automatically
# as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Comma-separated allowlist for /admin/review. Authentication is not authorization.
ADMIN_EMAILS=
